keybind = super+shift+comma=reload_config

# Themeing
theme = "tokyonight"
font-size = 14

font-family = "MesloLGS NF"
background-opacity = 0.93

macos-icon = custom-style
macos-icon-frame = beige
macos-icon-ghost-color = white
macos-icon-screen-color = purple,maroon

## Shader. Check out here: https://github.com/m-ahdal/ghostty-shaders
custom-shader = shaders/bloom.glsl
# custom-shader = shaders/cursor_blaze.glsl
# custom-shader = shaders/cursor_blaze_no_trail.glsl
# custom-shader = shaders/cursor_blaze_tapered.glsl
# custom-shader = shaders/cursor_frozen.glsl
# custom-shader = shaders/cursor_smear.glsl
custom-shader = shaders/cursor_smear_fade.glsl
# custom-shader = shaders/debug_cursor_animated.glsl
# custom-shader = shaders/debug_cursor_static.glsl

## Options
macos-option-as-alt = left
window-decoration = true
clipboard-read = "allow"
clipboard-paste-protection = false
keybind = global:cmd+/=toggle_quick_terminal

shell-integration-features = no-cursor,sudo,no-title

auto-update = download

## Auto run tmux when opening ghostty
# command = zsh --login -c "if command -v tmux >/dev/null 2>&1; then tmux attach || tmux; else zsh; fi"

